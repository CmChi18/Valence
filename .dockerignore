# Build context hygiene. Nothing here belongs in the image.
.git
.gitignore
.github
AGENTS.md
README.md
fly.toml
Dockerfile
.dockerignore

# Local artifacts
Valence
*.out
*.test
.env

# Frontend deps and build output. node_modules is ~50MB per app; letting it into
# the build context alone would dwarf the 512MB target.
apps/*/node_modules/
apps/*/dist/
node_modules/
